# Copy to .env and fill in. .env is in .gitignore: your real address never goes to GitHub.
# docker compose reads .env and bakes these values into the static pages at build time.

# Public address of the site (canonical and language links)
SITE_URL=https://cretelab.example

# For compose.tls.yaml: the host name Caddy gets a certificate for
DOMAIN=cretelab.example

# Legal notice (Impressum, § 5 DDG) and controller in the privacy policy (Art. 13 DSGVO)
LEGAL_NAME=Max Mustermann
LEGAL_STREET=Musterstraße 1
LEGAL_CITY=12345 Musterstadt
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=kontakt@cretelab.example
# Optional
LEGAL_PHONE=
# Optional: the hosting provider, if the server is not run by you yourself (name and address)
LEGAL_HOSTING=
